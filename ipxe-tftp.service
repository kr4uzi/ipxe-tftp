[Unit]
Description=iPXE Readonly TFTP Server
After=network.target
Wants=network-online.target

[Service]
Restart=always
Type=simple

# Runs as a uid systemd allocates at start and retires at stop, so there is no
# account to create. Port 69 is privileged and that capability is the only power
# the daemon needs; it reads one directory and answers UDP.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# The TFTP directory served to clients.
ExecStart=/srv/ipxe-tftp/.venv/bin/python /srv/ipxe-tftp/tftp.py --root /srv/pxe

[Install]
WantedBy=multi-user.target